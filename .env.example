# Copy this file to .env and fill in the key. .env is ignored by git.
# The runners read .env from the repo root; a variable already set in the shell wins over this file.

# Anthropic API key with access to claude-opus-5-5 and claude-fable-5-2.
# Fable 5.2 needs 30-day data retention on the organization.
ANTHROPIC_API_KEY=
